# Base URL of the backend API. In localhost mode the FastAPI server runs
# directly on :8000 (no nginx). Auth cookies are same-site as long as this
# shares a registrable domain with the page origin — localhost with any port
# counts as same-site, so this works for local dev as-is.
#
# If you serve the backend behind nginx on :80 instead, use http://localhost.
VITE_API_BASE_URL=http://localhost:8000
