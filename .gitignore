.env
# Any local env backups/variants (e.g. .env.bak.<ts>, .env.local) — never
# commit these, they hold the same secrets as .env. .env.example stays tracked.
.env.*
!.env.example
__pycache__/
*.pyc
.venv/
venv/
engagements/*/
!engagements/.gitkeep
certbot/conf/*
!certbot/conf/.gitkeep
certbot/www/*
!certbot/www/.gitkeep
*.log
.DS_Store
*.db
*.sqlite3

.claude