# --- App ---
ENVIRONMENT=development
# REQUIRED outside development: must be a strong, unique value of >=32 chars.
# Startup fails fast if left at the dev placeholder in a non-dev environment.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Supabase (Postgres + Auth + Realtime + pgvector) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                    # direct Postgres connection string for SQLAlchemy/LangGraph

# --- Redis / ARQ ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- CORS ---
# Must be the EXACT origin the browser sends. In production this is your
# Vercel custom domain (scheme + host, no trailing slash), e.g.:
#   FRONTEND_ORIGIN=https://maximreconforge.tech
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Additional allowed browser origins, comma-separated. Defaults to the local
# Vite dev origins (3000 / 5173), which have no business in production —
# set this to an EMPTY value there. Also add any extra production origin that
# is same-site but a distinct origin, e.g. https://www.maximreconforge.tech.
EXTRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000

# --- Execution mode ---
# true  = run the recon graph inline in the API process and stream progress
#         over WebSocket. This is currently the ONLY working mode.
# false = dispatch to the Redis/arq worker, whose run_recon is still a stub
#         that runs nothing and publishes no live events. Do not use yet.
RUN_SCANS_INLINE=true

# --- Auth cookies ---
# Local dev (same-origin, no TLS): lax / false.
# Production over HTTPS where frontend + backend share a registrable domain
# (maximreconforge.tech + api.maximreconforge.tech = same-site): lax / true.
# Production where frontend + backend are DIFFERENT registrable domains
# (e.g. *.vercel.app + api.maximreconforge.tech): none / true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- TLS / certbot (leave blank for local dev) ---
# DOMAIN is the backend host served on the VPS; CERTBOT_EMAIL receives
# expiry notices and is required by scripts/init-tls.sh.
DOMAIN=
CERTBOT_EMAIL=

# --- LLM: Groq (active provider — free tier) ---
GROQ_API_KEY=
LLM_DEFAULT_MODEL=openai/gpt-oss-120b
LLM_REPORTING_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b

# --- LLM: Anthropic (future — not active yet) ---
ANTHROPIC_API_KEY=

# --- Embeddings (stub until Voyage AI key provided) ---
VOYAGEAI_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1024

# --- Circuit breakers ---
VULN_ANALYSIS_ITERATION_CAP=10
EXPLOITATION_ITERATION_CAP=20
VULN_ANALYSIS_TOKEN_CEILING=100000
EXPLOITATION_TOKEN_CEILING=200000
